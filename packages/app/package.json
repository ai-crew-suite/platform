{
  "name": "dev-app",
  "version": "0.0.0",
  "private": true,
  "bundled": true,
  "license": "Apache-2.0",
  "keywords": [
    "agentic workflow",
    "ai-crew-suite",
    "app",
    "backstage"
  ],
  "backstage": {
    "role": "frontend"
  },
  "files": [
    "dist"
  ],
  "bugs": {
    "url": "https://github.com/ai-crew-suite/ai-crew-suite/issues",
    "email": "support@ai-crew-suite.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ai-crew-suite/ai-crew-suite",
    "directory": "packages/app"
  },
  "scripts": {
    "build": "crew build",
    "clean": "crew clean",
    "lint": "crew lint",
    "test:e2e": "crew test:e2e",
    "test:unit": "crew test:unit",
    "test:unit:coverage": "crew test:unit:coverage",
    "typecheck": "crew typecheck"
  },
  "dependencies": {
    "@ai-crew-suite/plugin-platform-backend": "workspace:^",
