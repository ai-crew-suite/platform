    "@emotion/styled": "catalog:prod",
    "@material-ui/core": "catalog:prod",
    "@material-ui/icons": "catalog:prod",
    "@mui/material": "catalog:prod",
    "@rjsf/utils": "^6.10.0",
    "i18next": "catalog:prod",
    "prop-types": "^15.8.1",
    "react": "catalog:prod",
    "react-dom": "catalog:prod",
    "react-router": "catalog:prod",
    "react-router-dom": "catalog:prod"
