{
  "name": "@ai-crew-suite/plugin-vector-store-backend",
  "description": "Vector Store Backend plugin for the AI Crew Suite platform.",
  "version": "0.0.1",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "license": "Apache-2.0",
  "keywords": [
    "backstage",
    "backstage-plugin",
    "backend",
    "ai-crew-suite",
    "ai-orchestration",
    "langgraph",
    "multi-agent",
    "rag",
    "extension-points"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "backstage": {
    "role": "backend-plugin",
    "pluginId": "vector-store",
    "pluginPackage": [
      "@ai-crew-suite/plugin-vector-store-backend",
      "@ai-crew-suite/plugin-vector-store-node"
    ]
  },
  "bugs": {
    "url": "https://github.com/ai-crew-suite/platform/issues",
    "email": "support@ai-crew-suite.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ai-crew-suite/platform",
    "directory": "plugins/vector-store-backend"
  },
  "files": [
    "dist",
    "config.d.ts"
  ],
  "configSchema": "config.d.ts",
  "scripts": {
    "build": "yarn sync-config-types && crew build",
    "clean": "crew clean",
    "lint": "yarn sync-config-types && crew lint",
    "sync-config-types": "node scripts/sync-config-types.mjs",
    "test:e2e": "yarn sync-config-types && crew test:e2e",
    "test:unit": "yarn sync-config-types && crew test:unit",
    "test:unit:coverage": "yarn sync-config-types && crew test:unit:coverage",
    "typecheck": "yarn sync-config-types && crew typecheck"
  },
  "dependencies": {
    "@ai-crew-suite/plugin-platform-node": "workspace:^",
    "@azure/search-documents": "catalog:prod",
    "@backstage/backend-common": "catalog:prod",
    "@backstage/backend-defaults": "backstage:^",
    "@backstage/backend-plugin-api": "backstage:^",
    "@backstage/config": "backstage:^",
    "@backstage/plugin-permission-common": "backstage:^",
    "@google-cloud/aiplatform": "catalog:prod",
    "@opensearch-project/opensearch": "catalog:prod",
    "@opentelemetry/api": "^1.9.1",
    "@pinecone-database/pinecone": "catalog:prod",
    "@qdrant/js-client-rest": "catalog:prod",
    "@zilliz/milvus2-sdk-node": "catalog:prod",
    "express": "catalog:prod",
    "express-promise-router": "catalog:prod",
    "i18next": "catalog:prod",
    "zod": "catalog:prod"
  },
  "devDependencies": {
    "@ai-crew-suite/crew-cli": "catalog:dev",
    "@ai-crew-suite/typescript-shared-config": "catalog:dev",
    "@jest/globals": "catalog:dev",
    "@types/compression": "catalog:dev",
    "@types/express": "catalog:dev",
    "vitest": "catalog:dev"
  }
}
