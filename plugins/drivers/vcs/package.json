{
  "name": "@ai-crew-suite/plugin-tools-vcs-backend",
  "description": "Host backend integration plugin for vendor-neutral version control systems, repository metadata tracking, and code management within the AI Crew Suite platform.",
  "version": "0.0.1",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "license": "Apache-2.0",
  "keywords": [
    "agentic workflow",
    "ai-crew-suite",
    "backend-plugin",
    "backstage-plugin-module",
    "backstage",
    "llm",
    "version control systems"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "backstage": {
    "role": "backend-plugin",
    "pluginId": "tools-vcs",
    "pluginPackage": [
      "@ai-crew-suite/plugin-platform-backend",
      "@ai-crew-suite/plugin-platform-node"
    ]
  },
  "bugs": {
    "url": "https://github.com/ai-crew-suite/ai-crew-suite/issues",
    "email": "support@ai-crew-suite.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ai-crew-suite/ai-crew-suite",
    "directory": "plugins/tools/vcs/engine"
  },
  "files": [
    "dist",
    "config.d.ts"
  ],
  "configSchema": "config.d.ts",
  "scripts": {
    "build": "crew build",
    "clean": "crew clean",
    "lint": "crew lint",
    "test:e2e": "crew test:e2e",
