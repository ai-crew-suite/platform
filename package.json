{
  "name": "@ai-crew-suite/platform",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": "22 || 24",
    "npm": "Please use Yarn instead (Corepack enable)"
  },
  "packageManager": "yarn@4.18.1",
  "workspaces": [
    "packages/*",
    "plugins/**/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo clean",
    "lint": "turbo run lint",
    "start": "backstage-cli workbench compose start",
    "stop": "backstage-cli workbench compose stop",
    "storybook": "crew storybook",
    "storybook:build": "crew storybook:build",
    "sync": "crew sync:refs",
    "test": "yarn test:unit && yarn test:unit:coverage",
    "test:unit": "turbo run test:unit",
    "test:unit:coverage": "turbo run test:unit -- --coverage",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "@ai-crew-suite/crew-cli": "catalog:dev",
    "@ai-crew-suite/crew-cli": "catalog:dev",
    "@ai-crew-suite/dependencies-frontend": "catalog:dev",
    "@ai-crew-suite/dependencies-backend": "catalog:dev",
    "@ai-crew-suite/typescript-shared-config": "catalog:dev",
    "@backstage/cli": "backstage:^",
    "@backstage/cli-defaults": "backstage:^",
    "@backstage/cli-module-new": "backstage:^",
    "@backstage/config": "backstage:^",
    "@changesets/cli": "catalog:dev",
    "@playwright/test": "catalog:dev",
    "@types/node": "catalog:dev",
    "storybook": "catalog:dev",
    "typescript": "catalog:dev"
  },
  "resolutions": {
    "@types/node": "^26.1.1",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "got": "11.8.6",
    "typescript": "6.0.3"
  }
}
