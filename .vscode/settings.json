{
  "cSpell.customDictionaries": {
    "org-words": {
      "path": "./.cspell/shared.txt",
      "addWords": false
    }
  },
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "editor.formatOnSave": true,
  "json.schemas": [
    {
      "fileMatch": [".yarnrc.yml"],
      "url": "https://yarnpkg.com/configuration/yarnrc.json"
    }
  ],
  "json.schemaDownload.trustedDomains": {
    "https://*.turborepo.dev": true
  },
  "search.exclude": {
    "**/.yarn": true,
    "**/node_modules": true,
    "**/.turbo": true,
    "**/dist": true,
    "**/.cache": true,
    "**/coverage": true
  },
  "yaml.schemas": {
    "https://json.schemastore.org/catalog-info.json": [
      "**/catalog-info.yaml",
      "master-catalogs.yml"
    ]
  },
  "yaml.validate": true
}
